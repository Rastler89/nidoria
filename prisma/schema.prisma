generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model preRegister {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
}

model User {
  id            Int         @id @default(autoincrement())
  username      String
  email         String      @unique
  password      String
  token         String?
  refresh_token String?
  verified      DateTime?
  createdAt     DateTime    @default(now()) @map("created_at")
  lastLogin     DateTime?   @map("last_login")
  role          String      @default("user")
  isActive      Boolean      @default(false)
  onboardingDone Boolean    @default(false) @map("onboarding_done")
  anthills      Anthill[]
  titles        UserTitle[]
  reports       Report[]
  missionClaims MissionClaim[]
}

model Title {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  requirements Json?
  style        Json?       // Para efectos CSS especiales (ej: brillo dorado)
  users        UserTitle[]
}

model UserTitle {
  userId     Int      @map("user_id")
  titleId    Int      @map("title_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")
  title      Title    @relation(fields: [titleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, titleId])
  @@map("user_title")
}

model Anthill {
  id                   Int                    @id @default(autoincrement())
  ownerId              Int                    @map("owner_id")
  positionX            Int                    @map("position_x")
  positionY            Int                    @map("position_y")
  eggs                 Int
  larva                Int
  ants                 Int
  antsBusy             Int                    @map("ants_busy")
  capacities           Json                   @default("{\"FOOD\": 500, \"LEAD\": 500, \"WOOD\": 500}")
  popMax               Int                    @default(50) @map("pop_max")
  militaryPopMax       Int                    @default(0) @map("military_pop_max")
  
  // Campos de Poder para el Ranking
  powerConstruction    Int                    @default(0) @map("power_construction")
  powerInvestigation   Int                    @default(0) @map("power_investigation")
  powerMilitary        Int                    @default(0) @map("power_military")
  powerTotal           Int                    @default(0) @map("power_total")

  worldId              Int?                   @map("world_id")
  owner                User                   @relation(fields: [ownerId], references: [id])
  world                World?                 @relation(fields: [worldId], references: [id])
  aggressorDeployments Deployment[]           @relation("AggressorDeployment")
  defensorDeployments  Deployment[]           @relation("DefensorDeployment")
  attackerBattles      Battle[]               @relation("BattleAttacker")
  defenderBattles      Battle[]               @relation("BattleDefender")
  antsTotal            AntsAnthill[]
  constructions        ConstructionAnthill[]
  explorations         Exploration[]
  investigations       InvestigationAnthill[]
  resources            ResourceAnthill[]

  @@index([positionX, positionY])
  @@index([worldId])
  @@index([powerTotal]) // Index para el ranking
}

model Construction {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  code         String                @unique
  preview      Int?
  effects      Json?
  points       Int                   @default(0) // Puntos por nivel
  base_food    Int
  base_wood    Int
  base_lead    Int
  base_time    Int
  base_ants    Int
  multiplier   Float
  maxInstances Int                   @default(1)
  maxLevel     Int                   @default(1)
  anthills     ConstructionAnthill[]
}

model Investigation {
  id         Int                    @id @default(autoincrement())
  name       String                 @unique
  code       String                 @unique
  preview    Int?
  effects    Json?
  points     Int                    @default(0) // Puntos por nivel
  base_food  Int
  base_wood  Int
  base_lead  Int
  base_time  Int
  base_ants  Int
  multiplier Float
  maxLevel   Int                    @default(1)
  anthills   InvestigationAnthill[]
}

model Ant {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  code          String        @unique
  type          AntType
  attack        Int
  defense       Int
  speed_attack  Int           @default(1)
  speed_defense Int           @default(1)
  heal          Int
  capacity      Int
  points        Int           @default(0) // Puntos por unidad
  base_food     Int
  base_wood     Int
  base_lead     Int
  base_ants     Int
  base_time     Int
  anthills      AntsAnthill[]
  deployments   AntsDeploy[]
}

model Resource {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  type         ResourceType
  explorations Exploration[]
  resources    ResourceAnthill[]
}

model Deployment {
  id          Int            @id @default(autoincrement())
  type        DeploymentType
  aggressorId Int            @map("anthill_aggressor")
  defensorId  Int            @map("anthill_defensor")
  init        DateTime       @map("init")
  finish      DateTime       @map("finish")
  result      Json?
  aggressor   Anthill        @relation("AggressorDeployment", fields: [aggressorId], references: [id])
  defensor    Anthill        @relation("DefensorDeployment", fields: [defensorId], references: [id])
  ants        AntsDeploy[]
}

model AntsDeploy {
  antsId       Int        @map("ants")
  deploymentId Int        @map("deployment")
  quantity     Int
  ant          Ant        @relation(fields: [antsId], references: [id])
  deployment   Deployment @relation(fields: [deploymentId], references: [id])

  @@id([antsId, deploymentId])
  @@map("ants_deploy")
}

/// Catálogo de monstruos del PvE. El balance vive aquí (y en `pve.constants.ts`),
/// nunca en el cliente: el frontend solo pinta lo que devuelve la API.
model Monster {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  description String?
  tier        Int            @default(1)
  hp          Int
  attack      Int
  defense     Int
  speed       Int            @default(1)
  points      Int            @default(0)
  loot        Json           @default("{}")
  active      Boolean        @default(true)
  spawns      MonsterSpawn[]

  @@index([tier])
  @@map("monsters")
}

/// Aparición concreta de un monstruo en el mapa, creada aleatoriamente por el
/// planificador del backend y con caducidad.
model MonsterSpawn {
  id          Int                @id @default(autoincrement())
  monsterId   Int                @map("monster")
  worldId     Int?               @map("world")
  level       Int                @default(1)
  hpRemaining Int                @map("hp_remaining")
  positionX   Int                @map("position_x")
  positionY   Int                @map("position_y")
  status      MonsterSpawnStatus @default(ACTIVE)
  spawnedAt   DateTime           @default(now()) @map("spawned_at")
  expiresAt   DateTime           @map("expires_at")
  monster     Monster            @relation(fields: [monsterId], references: [id])
  world       World?             @relation(fields: [worldId], references: [id])
  battles     Battle[]

  @@index([status, expiresAt])
  @@index([worldId, status])
  @@map("monster_spawns")
}

/// Resultado de un combate. Nace sin resolver (`result` y `resolvedAt` nulos)
/// y se completa cuando el job de la cola lo procesa. Guarda una foto de las
/// unidades y de los stats para que el reporte sea reproducible aunque el
/// catálogo cambie después.
model Battle {
  id             Int           @id @default(autoincrement())
  type           BattleType
  attackerId     Int           @map("attacker_anthill")
  defenderId     Int?          @map("defender_anthill")
  spawnId        Int?          @map("monster_spawn")
  seed           String
  result         BattleResult?
  rounds         Json          @default("[]")
  attackerUnits  Json          @map("attacker_units") @default("[]")
  defenderUnits  Json          @map("defender_units") @default("[]")
  loot           Json          @default("{}")
  lossesAttacker Json          @map("losses_attacker") @default("{}")
  lossesDefender Json          @map("losses_defender") @default("{}")
  travelSeconds  Int           @map("travel_seconds") @default(0)
  startedAt      DateTime      @default(now()) @map("started_at")
  resolvedAt     DateTime?     @map("resolved_at")
  attacker       Anthill       @relation("BattleAttacker", fields: [attackerId], references: [id])
  defender       Anthill?      @relation("BattleDefender", fields: [defenderId], references: [id])
  spawn          MonsterSpawn? @relation(fields: [spawnId], references: [id])
  reports        Report[]

  @@index([attackerId, startedAt])
  @@index([spawnId])
  @@map("battles")
}

/// Buzón de un usuario: reportes de batalla y avisos del sistema.
/// `type` nace extensible para las alianzas (`ALLIANCE`) sin migrar de nuevo.
model Report {
  id        Int        @id @default(autoincrement())
  ownerId   Int        @map("owner_user")
  type      ReportType
  battleId  Int?       @map("battle")
  title     String
  body      Json       @default("{}")
  readAt    DateTime?  @map("read_at")
  createdAt DateTime   @default(now()) @map("created_at")
  owner     User       @relation(fields: [ownerId], references: [id])
  battle    Battle?    @relation(fields: [battleId], references: [id])

  @@index([ownerId, createdAt])
  @@map("reports")
}

model ConstructionAnthill {
  id             Int                @id @default(autoincrement())
  anthillId      Int                @map("anthill")
  constructionId Int                @map("construction")
  level          Int
  finishingAt    DateTime?          @map("finishing_at")
  status         ConstructionStatus @map("status")
  anthill        Anthill            @relation(fields: [anthillId], references: [id])
  construction   Construction       @relation(fields: [constructionId], references: [id])

  @@index([anthillId])
  @@index([constructionId])
  @@map("construction_anthill")
}

model InvestigationAnthill {
  id              Int                 @id @default(autoincrement())
  anthillId       Int                 @map("anthill")
  investigationId Int                 @map("investigation")
  level           Int
  finishingAt     DateTime?           @map("finishing_at")
  status          InvestigationStatus @map("status")
  anthill         Anthill             @relation(fields: [anthillId], references: [id])
  investigation   Investigation       @relation(fields: [investigationId], references: [id])

  @@index([anthillId])
  @@index([investigationId])
  @@map("investigation_anthill")
}

model AntsAnthill {
  antId     Int     @map("ant")
  anthillId Int     @map("anthill")
  total     Int
  busy      Int
  ant       Ant     @relation(fields: [antId], references: [id])
  anthill   Anthill @relation(fields: [anthillId], references: [id])

  @@id([antId, anthillId])
  @@map("ants_anthill")
}

model Exploration {
  anthillId      Int      @map("anthill")
  resourceTypeId Int      @map("resource_type")
  ants           Int
  createdAt      DateTime @default(now()) @map("created_at")
  duration       Int
  quantity       Int
  autoRepeatCount Int     @default(0) @map("auto_repeat_count")
  anthill        Anthill  @relation(fields: [anthillId], references: [id])
  resource       Resource @relation(fields: [resourceTypeId], references: [id])

  @@id([anthillId, resourceTypeId])
  @@map("exploration")
}

model ResourceAnthill {
  anthillId  Int      @map("anthill")
  resourceId Int      @map("resource")
  stock      Int
  anthill    Anthill  @relation(fields: [anthillId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@id([anthillId, resourceId])
  @@map("resource_anthill")
}

model Requirement {
  id            Int      @id @default(autoincrement())
  targetId      Int
  targetType    ItemType @map("target_type")
  targetLevel   Int      @default(1)
  requiredType  ItemType @map("required_type")
  requiredId    Int
  requiredLevel Int      @default(1)

  @@index([targetId])
}

model World {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  maxPlayers     Int       @default(1000)
  currentPlayers Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  anthills       Anthill[]
  monsterSpawns  MonsterSpawn[]

  @@map("worlds")
}

/// Anuncios globales gestionados desde /antmaster.
model Banner {
  id        Int       @id @default(autoincrement())
  message   String
  linkLabel String?   @map("link_label")
  linkUrl   String?   @map("link_url")
  variant   String    @default("info") // info | warning | danger
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  priority  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

enum AntType {
  ARTILLERY
  LIGHT
  WEIGHT
  SPECIAL
}

enum ResourceType {
  FOOD
  WOOD
  LEAD
}

enum DeploymentType {
  ATTACK
  DEFENSE
  EVENT
}

enum BattleType {
  PVE
  PVP
}

enum BattleResult {
  WIN
  LOSS
  DRAW
}

enum MonsterSpawnStatus {
  ACTIVE
  DEFEATED
  EXPIRED
}

enum ReportType {
  BATTLE
  SYSTEM
  ALLIANCE
}

enum MissionConditionType {
  HAVE_ANTS
  HAVE_FOOD_STOCK
  HAVE_WOOD_STOCK
  HAVE_LEAD_STOCK
  HAVE_CONSTRUCTIONS_COMPLETED
}

model Mission {
  id            Int                 @id @default(autoincrement())
  key           String              @unique
  title         String
  description   String
  conditionType MissionConditionType @map("condition_type")
  target        Int                 @default(1)
  rewardFood    Int                 @default(0) @map("reward_food")
  rewardWood    Int                 @default(0) @map("reward_wood")
  rewardLead    Int                 @default(0) @map("reward_lead")
  active        Boolean             @default(true)
  sortOrder     Int                 @default(0) @map("sort_order")
  claims        MissionClaim[]

  @@map("missions")
}

model MissionClaim {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  missionId Int      @map("mission_id")
  claimedAt DateTime @default(now()) @map("claimed_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_claims")
}

enum ConstructionStatus {
  BUILDING
  COMPLETED
  DAMAGED
  REPAIRING
}

enum InvestigationStatus {
  INVESTIGATING
  COMPLETED
}

enum ItemType {
  CONSTRUCTION
  INVESTIGATION
  ANT
}
