generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model preRegister {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
}

model User {
  id            Int         @id @default(autoincrement())
  username      String
  email         String      @unique
  password      String
  token         String?
  refresh_token String?
  verified      DateTime?
  createdAt     DateTime    @default(now()) @map("created_at")
  lastLogin     DateTime?   @map("last_login")
  role          String      @default("user")
  anthills      Anthill[]
  titles        UserTitle[]
}

model Title {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  requirements Json?
  style        Json?       // Para efectos CSS especiales (ej: brillo dorado)
  users        UserTitle[]
}

model UserTitle {
  userId     Int      @map("user_id")
  titleId    Int      @map("title_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")
  title      Title    @relation(fields: [titleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, titleId])
  @@map("user_title")
}

model Anthill {
  id                   Int                    @id @default(autoincrement())
  ownerId              Int                    @map("owner_id")
  positionX            Int                    @map("position_x")
  positionY            Int                    @map("position_y")
  eggs                 Int
  larva                Int
  ants                 Int
  antsBusy             Int                    @map("ants_busy")
  capacities           Json                   @default("{\"FOOD\": 500, \"LEAD\": 500, \"WOOD\": 500}")
  popMax               Int                    @default(50) @map("pop_max")
  militaryPopMax       Int                    @default(0) @map("military_pop_max")
  
  // Campos de Poder para el Ranking
  powerConstruction    Int                    @default(0) @map("power_construction")
  powerInvestigation   Int                    @default(0) @map("power_investigation")
  powerMilitary        Int                    @default(0) @map("power_military")
  powerTotal           Int                    @default(0) @map("power_total")

  worldId              Int?                   @map("world_id")
  owner                User                   @relation(fields: [ownerId], references: [id])
  world                World?                 @relation(fields: [worldId], references: [id])
  aggressorDeployments Deployment[]           @relation("AggressorDeployment")
  defensorDeployments  Deployment[]           @relation("DefensorDeployment")
  antsTotal            AntsAnthill[]
  constructions        ConstructionAnthill[]
  explorations         Exploration[]
  investigations       InvestigationAnthill[]
  resources            ResourceAnthill[]

  @@index([positionX, positionY])
  @@index([worldId])
  @@index([powerTotal]) // Index para el ranking
}

model Construction {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  code         String                @unique
  preview      Int?
  effects      Json?
  points       Int                   @default(0) // Puntos por nivel
  base_food    Int
  base_wood    Int
  base_lead    Int
  base_time    Int
  base_ants    Int
  multiplier   Float
  maxInstances Int                   @default(1)
  maxLevel     Int                   @default(1)
  anthills     ConstructionAnthill[]
}

model Investigation {
  id         Int                    @id @default(autoincrement())
  name       String                 @unique
  code       String                 @unique
  preview    Int?
  effects    Json?
  points     Int                    @default(0) // Puntos por nivel
  base_food  Int
  base_wood  Int
  base_lead  Int
  base_time  Int
  base_ants  Int
  multiplier Float
  maxLevel   Int                    @default(1)
  anthills   InvestigationAnthill[]
}

model Ant {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  code          String        @unique
  type          AntType
  attack        Int
  defense       Int
  speed_attack  Int           @default(1)
  speed_defense Int           @default(1)
  heal          Int
  capacity      Int
  points        Int           @default(0) // Puntos por unidad
  base_food     Int
  base_wood     Int
  base_lead     Int
  base_ants     Int
  base_time     Int
  anthills      AntsAnthill[]
  deployments   AntsDeploy[]
}

model Resource {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  type         ResourceType
  explorations Exploration[]
  resources    ResourceAnthill[]
}

model Deployment {
  id          Int            @id @default(autoincrement())
  type        DeploymentType
  aggressorId Int            @map("anthill_aggressor")
  defensorId  Int            @map("anthill_defensor")
  init        DateTime       @map("init")
  finish      DateTime       @map("finish")
  result      Json?
  aggressor   Anthill        @relation("AggressorDeployment", fields: [aggressorId], references: [id])
  defensor    Anthill        @relation("DefensorDeployment", fields: [defensorId], references: [id])
  ants        AntsDeploy[]
}

model AntsDeploy {
  antsId       Int        @map("ants")
  deploymentId Int        @map("deployment")
  quantity     Int
  ant          Ant        @relation(fields: [antsId], references: [id])
  deployment   Deployment @relation(fields: [deploymentId], references: [id])

  @@id([antsId, deploymentId])
  @@map("ants_deploy")
}

model ConstructionAnthill {
  id             Int                @id @default(autoincrement())
  anthillId      Int                @map("anthill")
  constructionId Int                @map("construction")
  level          Int
  finishingAt    DateTime?          @map("finishing_at")
  status         ConstructionStatus @map("status")
  anthill        Anthill            @relation(fields: [anthillId], references: [id])
  construction   Construction       @relation(fields: [constructionId], references: [id])

  @@index([anthillId])
  @@index([constructionId])
  @@map("construction_anthill")
}

model InvestigationAnthill {
  id              Int                 @id @default(autoincrement())
  anthillId       Int                 @map("anthill")
  investigationId Int                 @map("investigation")
  level           Int
  finishingAt     DateTime?           @map("finishing_at")
  status          InvestigationStatus @map("status")
  anthill         Anthill             @relation(fields: [anthillId], references: [id])
  investigation   Investigation       @relation(fields: [investigationId], references: [id])

  @@index([anthillId])
  @@index([investigationId])
  @@map("investigation_anthill")
}

model AntsAnthill {
  antId     Int     @map("ant")
  anthillId Int     @map("anthill")
  total     Int
  busy      Int
  ant       Ant     @relation(fields: [antId], references: [id])
  anthill   Anthill @relation(fields: [anthillId], references: [id])

  @@id([antId, anthillId])
  @@map("ants_anthill")
}

model Exploration {
  anthillId      Int      @map("anthill")
  resourceTypeId Int      @map("resource_type")
  ants           Int
  createdAt      DateTime @default(now()) @map("created_at")
  duration       Int
  quantity       Int
  anthill        Anthill  @relation(fields: [anthillId], references: [id])
  resource       Resource @relation(fields: [resourceTypeId], references: [id])

  @@id([anthillId, resourceTypeId])
  @@map("exploration")
}

model ResourceAnthill {
  anthillId  Int      @map("anthill")
  resourceId Int      @map("resource")
  stock      Int
  anthill    Anthill  @relation(fields: [anthillId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@id([anthillId, resourceId])
  @@map("resource_anthill")
}

model Requirement {
  id            Int      @id @default(autoincrement())
  targetId      Int
  targetType    ItemType @map("target_type")
  targetLevel   Int      @default(1)
  requiredType  ItemType @map("required_type")
  requiredId    Int
  requiredLevel Int      @default(1)

  @@index([targetId])
}

model World {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  maxPlayers     Int       @default(1000)
  currentPlayers Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  anthills       Anthill[]

  @@map("worlds")
}

enum AntType {
  ARTILLERY
  LIGHT
  WEIGHT
  SPECIAL
}

enum ResourceType {
  FOOD
  WOOD
  LEAD
}

enum DeploymentType {
  ATTACK
  DEFENSE
  EVENT
}

enum ConstructionStatus {
  BUILDING
  COMPLETED
  DAMAGED
  REPAIRING
}

enum InvestigationStatus {
  INVESTIGATING
  COMPLETED
}

enum ItemType {
  CONSTRUCTION
  INVESTIGATION
  ANT
}
