# === Servidor ===
# Puerto del servidor NestJS
PORT=4000
# development | production
NODE_ENV=development

# Base de datos (PostgreSQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://username:password@localhost:5432/databasename
# Versión de esquema esperada; Prisma aplica migraciones si no coincide
REQUIRED_DB_VERSION=1

# Redis (colas BullMQ + adapter de WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# Base de datos de tests (usada por npm run test:e2e / test:ai-player)
# Corre en el contenedor "test-database" del docker-compose (puerto 5433)
DATABASETEST_URL=postgresql://test-username:test-password@localhost:5433/test-databasename

# === Correo (Mailtrap por defecto en desarrollo) ===
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Nidoria Online" <no-reply@nidoria.com>

# URL pública de la app (usada en links de verificación de email)
APP_URL=http://localhost:3000

# Credenciales del dashboard del AI Player (Basic Auth)
AI_ADMIN_USER=admin
AI_ADMIN_PASS=cambiar-en-produccion

# Secreto para firmar JWT. OBLIGATORIO cambiarlo en producción.
# Mientras esté vacío se usa el valor por defecto del código (solo para dev).
JWT_SECRET=
