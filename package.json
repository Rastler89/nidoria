{
  "name": "nidoria",
  "version": "0.0.1",
  "description": "Nidoria Online Game Server",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env ENABLE_CRON='true' nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:prepare": "dotenv -- cross-env DATABASE_URL=$DATABASETEST_URL npx prisma migrate deploy",
    "test:e2e": "npm run test:prepare && dotenv -- cross-env DATABASE_URL=$DATABASETEST_URL jest --config ./test/jest-e2e.json",
    "test:ai-player": "npm run test:prepare && dotenv -- cross-env DATABASE_URL=$DATABASETEST_URL ts-node -r tsconfig-paths/register test/ai-player.ts",
    "start:worker": "cross-env ENABLE_CRON='false' ts-node -r tsconfig-paths/register src/main.worker.ts",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.0",
    "@bull-board/express": "^6.7.0",
    "@bull-board/nestjs": "^6.7.0",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/platform-socket.io": "^11.1.14",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/websockets": "^11.1.14",
    "@prisma/client": "^6.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^5.41.0",
    "ioredis": "^5.5.0",
    "nodemailer": "8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "glob": "11.0.1",
    "rimraf": "6.0.1",
    "tar": "7.4.3",
    "cross-spawn": "7.0.6",
    "path-to-regexp": "6.3.0",
    "minimatch": "10.0.1",
    "nodemailer": "$nodemailer",
    "ejs": "3.1.10",
    "jake": {
      "filelist": "1.0.4",
      "minimatch": "3.0.5"
    }
  }
}
